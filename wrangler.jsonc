{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "areflagslowered",
  "compatibility_date": "2026-05-22",
  "keep_vars": true,
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": { "binding": "IMAGES" }
}
